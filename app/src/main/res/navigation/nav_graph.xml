<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.test.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.test.LoginFragment"
        android:label="@string/login_fragment_label"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_registrationFragment"
            app:destination="@id/registrationFragment" />
        <action
            android:id="@+id/action_loginFragment_to_adminFragment"
            app:destination="@id/adminFragment" />
    </fragment>

    <fragment
        android:id="@+id/registrationFragment"
        android:name="com.example.test.RegistrationFragment"
        android:label="@string/registration_fragment_label"
        tools:layout="@layout/fragment_registration">
        <action
            android:id="@+id/action_registrationFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.test.HomeFragment"
        android:label="@string/home_fragment_label"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_savingsFragment"
            app:destination="@id/savingsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_loansFragment"
            app:destination="@id/loansFragment" />
        <action
            android:id="@+id/action_homeFragment_to_trackerFragment"
            app:destination="@id/trackerFragment" />
        <action
            android:id="@+id/action_homeFragment_to_groupFragment"
            app:destination="@id/groupFragment" />
        <action
            android:id="@+id/action_homeFragment_to_chatFragment"
            app:destination="@id/chatFragment" />
        <action
            android:id="@+id/action_homeFragment_to_notificationsFragment"
            app:destination="@id/notificationsFragment" />
    </fragment>

    <fragment
        android:id="@+id/savingsFragment"
        android:name="com.example.test.SavingsFragment"
        android:label="@string/savings_fragment_label"
        tools:layout="@layout/fragment_savings" />

    <fragment
        android:id="@+id/loansFragment"
        android:name="com.example.test.LoansFragment"
        android:label="@string/loans_fragment_label"
        tools:layout="@layout/fragment_loans" />

    <fragment
        android:id="@+id/trackerFragment"
        android:name="com.example.test.TrackerFragment"
        android:label="@string/tracker_fragment_label"
        tools:layout="@layout/fragment_tracker" />

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.example.test.ChatFragment"
        android:label="Support Chat"
        tools:layout="@layout/fragment_chat">
        <argument
            android:name="userId"
            app:argType="string"
            android:defaultValue="@null"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.example.test.NotificationsFragment"
        android:label="Notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/adminFragment"
        android:name="com.example.test.AdminFragment"
        android:label="Admin Dashboard"
        tools:layout="@layout/fragment_admin">
        <action
            android:id="@+id/action_adminFragment_to_userManagementFragment"
            app:destination="@id/userManagementFragment" />
        <action
            android:id="@+id/action_adminFragment_to_groupManagementFragment"
            app:destination="@id/groupManagementFragment" />
        <action
            android:id="@+id/action_adminFragment_to_loanManagementFragment"
            app:destination="@id/loanManagementFragment" />
        <action
            android:id="@+id/action_adminFragment_to_transactionMonitoringFragment"
            app:destination="@id/transactionMonitoringFragment" />
        <action
            android:id="@+id/action_adminFragment_to_chatFragment"
            app:destination="@id/chatFragment" />
        <action
            android:id="@+id/action_adminFragment_to_notificationsFragment"
            app:destination="@id/notificationsFragment" />
        <action
            android:id="@+id/action_adminFragment_to_adminWithdrawalApprovalFragment"
            app:destination="@id/adminWithdrawalApprovalFragment" />
    </fragment>

    <fragment
        android:id="@+id/userManagementFragment"
        android:name="com.example.test.UserManagementFragment"
        android:label="User Management"
        tools:layout="@layout/fragment_user_management" />

    <fragment
        android:id="@+id/groupManagementFragment"
        android:name="com.example.test.GroupManagementFragment"
        android:label="Group Management"
        tools:layout="@layout/fragment_group_management" />

    <fragment
        android:id="@+id/loanManagementFragment"
        android:name="com.example.test.LoanManagementFragment"
        android:label="Loan Management"
        tools:layout="@layout/fragment_loan_management" />

    <fragment
        android:id="@+id/transactionMonitoringFragment"
        android:name="com.example.test.TransactionMonitoringFragment"
        android:label="Transaction Monitoring"
        tools:layout="@layout/fragment_transaction_monitoring" />

    <fragment
        android:id="@+id/adminWithdrawalApprovalFragment"
        android:name="com.example.test.AdminWithdrawalApprovalFragment"
        android:label="Withdrawal Approvals"
        tools:layout="@layout/fragment_admin_withdrawal_approval" />

    <fragment
        android:id="@+id/groupFragment"
        android:name="com.example.test.GroupFragment"
        android:label="Groups"
        tools:layout="@layout/fragment_group">
        <argument
            android:name="groupId"
            app:argType="string"
            android:defaultValue="@null"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/firstFragment"
        android:name="com.example.test.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_first_fragment_to_second_fragment"
            app:destination="@id/secondFragment" />
    </fragment>

    <fragment
        android:id="@+id/secondFragment"
        android:name="com.example.test.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_second">

        <action
            android:id="@+id/action_second_fragment_to_first_fragment"
            app:destination="@id/firstFragment" />
    </fragment>
</navigation>
